# ═══════════════════════════════════════════════════════════════════════════════
# Veluna Store — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
#
# Architecture: ONE single Next.js 14 app — no separate backend server.
# Port: 3000 (set this in Easypanel service port field)
#
# All variables below go into the SAME Easypanel service ("backend").
# NEXT_PUBLIC_ variables are sent to the browser (embedded at build time).
# All other variables stay server-side only.
#
# Local dev: copy this file to frontend/.env.local and fill in values.
# Production: add these in Easypanel → veluna → backend → Environment tab.
# ═══════════════════════════════════════════════════════════════════════════════


# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Admin Auth (SERVER ONLY — never expose to browser) ───────────────────────
# Password to log in at /admin
ADMIN_PASSWORD=

# Random secret stored in session cookie — generate: openssl rand -hex 32
ADMIN_SECRET_TOKEN=

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string — get exact value from Easypanel → veluna-db → Credentials tab
DATABASE_URL=postgres://postgres:PASSWORD@veluna-db:5432/veluna?sslmode=disable

# ── Public site URL (sent to browser) ────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://veluna.ma

# ── WhatsApp (sent to browser) ───────────────────────────────────────────────
# International format, no + sign, no spaces. Example: 212612345678
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ═══════════════════════════════════════════════════════════════════════════════
# Advertising / Pixels
# ═══════════════════════════════════════════════════════════════════════════════
# Pixel IDs and access tokens are configured in the admin UI at
#   https://veluna.ma/admin/advertising
# and stored in Postgres (table `ad_settings`). Tokens are encrypted with
# AES-256-GCM before they are written, so the key below is REQUIRED before any
# token can be saved. Without it the admin UI refuses to store the token rather
# than falling back to plaintext.
#
# ── REQUIRED for server-side conversions (SERVER ONLY) ───────────────────────
# 32 bytes. Generate with: openssl rand -hex 32
# Changing this value makes previously saved tokens unreadable — you will have
# to re-enter them in /admin/advertising.
AD_TRACKING_ENCRYPTION_KEY=

# ── Legacy pixel variables (optional, backwards compatible) ──────────────────
# These still work, but the admin UI takes precedence over every one of them.
# Prefer configuring everything in /admin/advertising and leaving these empty.
#
# NEVER put an access token in a NEXT_PUBLIC_ variable — those are compiled into
# the browser bundle and are readable by anyone.
NEXT_PUBLIC_META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
SNAPCHAT_ACCESS_TOKEN=

# ── Google Sheets order webhook (optional) ────────────────────────────────────
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
